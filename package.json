{
  "name": "davidhlp-github-io",
  "version": "1.0.0",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "postinstall": "node scripts/patch-rolling-number.mjs",
    "predev": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs",
    "dev": "astro dev --host 127.0.0.1",
    "prebuild": "node scripts/patch-rolling-number.mjs && node scripts/export-records.mjs && node scripts/prepare-webfonts.mjs",
    "check:content": "node --experimental-strip-types --test scripts/check-content.mjs",
    "check:viewport": "node --experimental-strip-types scripts/check-viewport.mjs",
    "export:archives": "node scripts/export-records.mjs",
    "check": "astro check",
    "build": "astro check && astro build && node scripts/build-pwa.mjs",
    "build:cloudflare": "npm run build && node scripts/package-cloudflare.mjs",
    "format": "prettier --write src scripts content astro.config.ts package.json tsconfig.json",
    "preview": "astro preview --host 127.0.0.1",
    "kb:lint": "node --experimental-strip-types scripts/kb-lint.ts",
    "kb:ingest": "node --experimental-strip-types scripts/kb-ingest-sessions.ts",
    "test:kb": "vitest run scripts/kb-ingest-sessions.test.ts"
  },
  "dependencies": {
    "astro": "7.3.6",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "yaml": "2.9.1",
    "@kitlangton/rolling-number": "0.4.1",
    "three": "^0.183.0",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "prettier-plugin-astro": "1.1.0",
    "@astrojs/check": "0.9.10",
    "@types/three": "^0.183.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "5.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidHLP/DavidHLP.github.io.git"
  },
  "homepage": "https://davidhlp.github.io"
}
