---
import manifest from "../../migration/manifest.json";
export function getStaticPaths() {
  return Object.entries(manifest.routes).filter(([path]) => !path.endsWith("/feed.xml")).map(([path, target]) => ({
    params: { legacy: path.slice(1) },
    props: { target, log: path.endsWith("/kb") ? manifest.routes[path.replace(/\/kb$/, "/kb-log") as keyof typeof manifest.routes] : undefined },
  }));
}
const { target, log } = Astro.props;
---
<!doctype html>
<html lang="zh-CN"><head>
  <meta charset="utf-8" />
  <meta name="robots" content="noindex" />
  <meta http-equiv="refresh" content={`0;url=${target}`} />
  <link rel="canonical" href={new URL(target, Astro.site)} />
  <title>文档已迁移</title>
</head><body data-target={target} data-log={log}>
  <p><a href={target}>阅读迁移后的文档 ↗</a></p>
  <script is:inline>
    const { target, log } = document.body.dataset;
    const isLog = location.hash === "#log" && log;
    location.replace((isLog ? log : target) + location.search + (isLog ? "" : location.hash));
  </script>
</body></html>
