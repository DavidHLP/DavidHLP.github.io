---
import config from "$config";
import App from "$layouts/App.astro";
import { localeUrl } from "$utils/locale-url";
import i18nit from "$i18n";
import { ts } from "$utils/labels";
import ThemeSwitcher from "$layouts/header/ThemeSwitcher.astro";
import "../rhine/fonts.css";
import "$styles/rhine-reader.css";
import "$styles/global.css";
import "$styles/markdown.css";
import "photoswipe/style.css";
import "katex/dist/katex.min.css";

const { locale = config.i18n.defaultLocale, title: subtitle, description = config.description, article } = Astro.props;
const title = config.title;
const t = i18nit(locale);
---

<script>
	// Client-side enhancers (PhotoSwipe, Mermaid, time-localize, theme observer)
	// live in `src/scripts/` so each one is testable, replaceable, and lazy-load
	// friendly. Mount order is the orchestrator's concern, not the layout's.
	import "$scripts";
</script>

<App {locale} {title} {subtitle} {description} {article} author={config.author.name}>
	<div class="site-shell rhine-reader">
		<div id="body" class="flex flex-col min-h-screen">
			<header class="reader-header">
				<a class="reader-brand" href={localeUrl(locale, "/")}><strong>DAVIDHLPL</strong><span>{ts(t, "rhine.page.personalArchive")} / {ts(t, "rhine.page.analysisOs")}</span></a>
				<nav aria-label={ts(t, "navigation.label")}><a href={localeUrl(locale, "/")}>← {ts(t, "rhine.archive.overview")}</a><a href={localeUrl(locale, "/about")}>{ts(t, "navigation.about")}</a><a href={localeUrl(locale, "/feed.xml")}>{ts(t, "navigation.subscription")} ↗</a><ThemeSwitcher locale={locale} /></nav>
			</header>
			<div class="reader-label"><span>{ts(t, "rhine.page.publicDatabase")}</span><span>DOCUMENT / {locale.toUpperCase()}</span></div>

			<slot />
		</div>

		<footer class="reader-footer"><span>© {new Date().getFullYear()} {config.author.name}</span><a href="https://github.com/LBEILC/RhineLabUI">RhineLabUI</a><a href="/licenses/RhineLabUI-MIT.txt">{ts(t, "rhine.page.mitLicense")}</a><a href={localeUrl(locale, "/policy")}>{ts(t, "navigation.policy")}</a></footer>
	</div>
</App>
