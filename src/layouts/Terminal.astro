---
import Profile from "../components/Profile.astro";
import { aboutPath } from "../about-path";
import { render, type CollectionEntry } from "astro:content";
import site from "../../content/site.json";
import { getPosts, postPath } from "../lib/blog";
import "../blog.css";
import labels from "../../content/locales.json";
import { contentLabel } from "../content-language";
import { translateUiText } from "../ui-language";

interface Props { post?: CollectionEntry<"blog"> }
const { post } = Astro.props;
const posts = await getPosts();
const rendered = post ? [{ entry: post, ...await render(post) }] : [];
const records = posts.map(entry => ({ ...entry.data, id: entry.data.archiveId, slug: entry.id }));
const payload = JSON.stringify({ records, categories: site.categories, columns: site.columns })
  .replace(/</g, "\\u003c");
const title = post ? `${post.data.title} · ${site.title}` : site.title;
const description = post?.data.abstract ?? site.description;
const canonical = new URL(post ? postPath(post.id) : "/", Astro.site);
const language = post?.data.lang ?? "zh-CN";
const localize = (value: string) => contentLabel(value, language, labels);
const t = (value: string) => translateUiText(value, language);
---
<!doctype html>
<html lang={language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#e8e5e1" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={site.title} />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
    <meta name="description" content={description} />
    <meta name="author" content={post?.data.lead ?? site.author} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={post ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    {post && <meta property="article:published_time" content={post.data.pubDate.toISOString()} />}
    {post?.data.updatedDate && <meta property="article:modified_time" content={post.data.updatedDate.toISOString()} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body data-post={post?.id} data-content-language={language} data-site-title={site.title} data-site-description={site.description} data-site-author={site.author} data-site-url={Astro.site}>
    <main id="viewport"><div id="stage"></div></main>
    <div id="blog-static" class="blog-static">
      <header><a href={aboutPath(language)}>{t("关于")}</a> <a href="/" translate="no">{site.title}</a> <a id="blog-interactive-link" hidden>{t("返回交互界面 ↗")}</a> <a href={language === "zh-CN" ? "/rss.xml" : `/${language}/rss.xml`}>RSS ↗</a><select data-ui-language aria-label={t("界面语言")}><option value="zh-CN" selected={language === "zh-CN"}>中文</option><option value="en" selected={language === "en"}>English</option><option value="ja" selected={language === "ja"}>日本語</option></select></header>
      {post ? <article>
        <div class="detail-kicker" translate="no">{t(`FILE ${post.data.archiveId}`)} / {localize(post.data.category)}</div>
        <h1 translate="no">{post.data.title}</h1>
        <p translate="no">{localize(post.data.en)}</p>
        <p>{t("发布")} <time datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 10)}</time>{post.data.updatedDate && <> / {t("更新")} <time datetime={post.data.updatedDate.toISOString()}>{post.data.updatedDate.toISOString().slice(0, 10)}</time></>} / <span translate="no">{post.data.lead}</span></p>
        {post.data.profile && <Profile profile={post.data.profile} />}
        <div class="blog-body" lang={post.data.lang} translate="no">{rendered.map(({ Content }) => <Content />)}</div>
        <h2>{t("研究记录")}</h2><ol translate="no">{post.data.findings.map(finding => <li>{finding}</li>)}</ol>
        <p><a href={post.data.source} rel="noopener">{t("设定参考 ↗")}</a></p>
      </article> : <section>
        <h1 translate="no">{site.title}</h1><p>{site.description}</p>
        {site.columns.map(column => <section><h2>{column}</h2><ul>
          {posts.filter(entry => entry.data.category === column).map(entry => <li data-content-locale={entry.data.lang} translate="no">
            <a href={postPath(entry.id)}>{entry.data.title}</a> — {entry.data.abstract}
          </li>)}
        </ul></section>)}
      </section>}
    </div>
    {rendered.map(({ entry, Content }) => <template data-blog-body={entry.id}>{entry.data.profile && <Profile profile={entry.data.profile} />}<Content /></template>)}
    <script id="blog-data" type="application/json" is:inline set:html={payload}></script>
    <script>
      import { initUiLanguage, restoreContentLanguage } from "../ui-language";
      initUiLanguage();
      const staticRoot = document.querySelector<HTMLElement>("#blog-static")!;
      const interactiveLink = document.querySelector<HTMLAnchorElement>("#blog-interactive-link")!;
      const staticIds = [...staticRoot.querySelectorAll<HTMLElement>("[id]")].map(node => ({ node, id: node.id }));
      function showStatic() {
        document.documentElement.classList.remove("interactive");
        staticRoot.removeAttribute("aria-hidden");
        staticIds.forEach(({ node, id }) => { node.id = id; });
        const interactiveUrl = new URL(location.href);
        interactiveUrl.searchParams.delete("view");
        interactiveLink.href = interactiveUrl.href;
        interactiveLink.hidden = false;
        staticRoot.querySelectorAll<HTMLAnchorElement>("a[href]").forEach(link => {
          if (link === interactiveLink) return;
          const url = new URL(link.href);
          if (url.origin === location.origin && (url.pathname === "/" || url.pathname.startsWith("/blog/") || /^\/(en\/|ja\/)?about\/?$/.test(url.pathname))) {
            url.searchParams.set("view", "static");
            link.href = url.href;
          }
        });
      }
      if (restoreContentLanguage()) { /* The matching article owns its rendered body and metadata. */ }
      else if (new URLSearchParams(location.search).get("view") === "static") showStatic();
      else void import("../main").catch(error => { console.error(error); showStatic(); });
    </script>
  </body>
</html>
